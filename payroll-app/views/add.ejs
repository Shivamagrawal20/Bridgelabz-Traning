<!DOCTYPE html>
<html>
<head>
<title>Add Employee</title>
<link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="header">
<h2 class="logo">EMPLOYEE PAYROLL</h2>
</div>


<div class="form-container">

<h2 class="form-title">Employee Payroll Form</h2>

<form action="/add" method="POST">


<label>Name</label>
<input type="text" name="name" required>



<label>Profile image</label>

<div class="profile-images">

<label>
<input type="radio" name="profileImage" value="https://randomuser.me/api/portraits/women/44.jpg">
<img src="https://randomuser.me/api/portraits/women/44.jpg">
</label>

<label>
<input type="radio" name="profileImage" value="https://randomuser.me/api/portraits/men/32.jpg">
<img src="https://randomuser.me/api/portraits/men/32.jpg">
</label>

<label>
<input type="radio" name="profileImage" value="https://randomuser.me/api/portraits/women/68.jpg">
<img src="https://randomuser.me/api/portraits/women/68.jpg">
</label>

<label>
<input type="radio" name="profileImage" value="https://randomuser.me/api/portraits/men/75.jpg">
<img src="https://randomuser.me/api/portraits/men/75.jpg">
</label>

</div>



<label>Gender</label>

<div class="gender-group">

<label>
<input type="radio" name="gender" value="Male"> Male
</label>

<label>
<input type="radio" name="gender" value="Female"> Female
</label>

</div>



<label>Department</label>

<div class="department-group">

<label>
<input type="checkbox" name="department" value="HR"> HR
</label>

<label>
<input type="checkbox" name="department" value="Sales"> Sales
</label>

<label>
<input type="checkbox" name="department" value="Finance"> Finance
</label>

<label>
<input type="checkbox" name="department" value="Engineer"> Engineer
</label>

</div>




<!-- <label>Salary</label> -->
<label>Salary</label>

<input type="number" name="salary" placeholder="Enter Salary" required>


<!-- <select name="salary">

<option>10000</option>
<option>20000</option>
<option>30000</option>
<option>40000</option>

</select> -->




<label>Start Date</label>

<input type="date" name="startDate">




<label>Notes</label>

<textarea name="notes"></textarea>




<div class="btn-group">

<button type="submit">Submit</button>

<button type="reset">Reset</button>

</div>



</form>

</div>


</body>
</html>
